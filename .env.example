NODE_ENV=development
PORT=3004
API_PREFIX=api/v1
TCP_HOST=0.0.0.0
TCP_PORT=4004

# Same JWT as auth-service
JWT_SECRET=nearo_dev_jwt_secret_change_in_prod_32chars_min_ok
JWT_ISSUER=nearo-auth
JWT_AUDIENCE=nearo-apps

# Read-only. Auth owns writes to devices / user_roles.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_NAME=nearo

CORS_ORIGINS=*

# Optional. If unset, job pushes are logged and sockets still emit.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
